{
  "slug": "getfy-example-gateway",
  "name": "Getfy Example Gateway",
  "version": "1.0.0",
  "description": "Plugin de referência para criar qualquer gateway de pagamento sem alterar o core.",
  "type": "gateway",
  "requires": {
    "getfy": ">=2.0.0",
    "plugin_api": 2
  },
  "gateway": {
    "methods": ["pix", "card", "boleto"]
  },
  "frontend": {
    "entry": "dist/plugin-ui.js",
    "manifest": "dist/ui.manifest.json",
    "checkout_gateway_slug": "example-gateway",
    "exports": {
      "checkout": {
        "pix": "PixMethod",
        "card": "CardMethod",
        "boleto": "BoletoMethod"
      },
      "tokenizeCard": "tokenizeCard"
    }
  }
}
